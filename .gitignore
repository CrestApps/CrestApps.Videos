# Videos are published on YouTube, never committed.
*.mp4
*.mov
*.webm
*.mp3
*.wav

# Generated by the scripts of each video: made again from the storyboard and the recorder.
videos/*/audio/
videos/*/clips/
videos/*/build/
videos/*/shots/
videos/*/check/
videos/*/*.png
videos/*/assemble.log

# Sign-ins, site copies and anything that can hold real people's data.
state*.json
mask*.js
test-admin.json
App_Data*/
tools/youtube/client_secret*.json
*.token.json

# Build output and tooling.
bin/
obj/
__pycache__/
*.pyc
.vs/
.vscode/
.idea/
