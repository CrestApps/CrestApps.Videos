{
  "name": "ContentTransferShowcase",
  "displayName": "Showcase",
  "description": "Fake event type with one of each kind of part and field.",
  "author": "CrestApps",
  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.Alias",
        "OrchardCore.Autoroute",
        "OrchardCore.ArchiveLater",
        "OrchardCore.PublishLater",
        "OrchardCore.Liquid",
        "OrchardCore.Markdown",
        "OrchardCore.Html",
        "OrchardCore.ContentFields",
        "OrchardCore.Media"
      ]
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "Showcase",
          "DisplayName": "Showcase",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Draftable": true,
              "Versionable": true,
              "Securable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                },
                "TitlePartSettings": {
                  "Options": "EditableRequired"
                }
              }
            },
            {
              "PartName": "HtmlBodyPart",
              "Name": "HtmlBodyPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "1"
                },
                "HtmlBodyPartSettings": {
                  "SanitizeHtml": true
                }
              }
            },
            {
              "PartName": "MarkdownBodyPart",
              "Name": "MarkdownBodyPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "2"
                }
              }
            },
            {
              "PartName": "AliasPart",
              "Name": "AliasPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "3"
                },
                "AliasPartSettings": {
                  "Pattern": "{{ ContentItem.DisplayText | slugify }}"
                }
              }
            },
            {
              "PartName": "AutoroutePart",
              "Name": "AutoroutePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "4"
                },
                "AutoroutePartSettings": {
                  "AllowCustomPath": true,
                  "Pattern": "events/{{ ContentItem.DisplayText | slugify }}"
                }
              }
            },
            {
              "PartName": "ArchiveLaterPart",
              "Name": "ArchiveLaterPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "5"
                }
              }
            },
            {
              "PartName": "PublishLaterPart",
              "Name": "PublishLaterPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "6"
                }
              }
            },
            {
              "PartName": "LiquidPart",
              "Name": "LiquidPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "7"
                }
              }
            },
            {
              "PartName": "Showcase",
              "Name": "Showcase",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "8"
                }
              }
            }
          ]
        }
      ],
      "ContentParts": [
        {
          "Name": "Showcase",
          "Settings": {},
          "ContentPartFieldDefinitionRecords": [
            {
              "FieldName": "TextField",
              "Name": "Location",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Location",
                  "Position": "0"
                }
              }
            },
            {
              "FieldName": "NumericField",
              "Name": "Seats",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Seats",
                  "Position": "1"
                }
              }
            },
            {
              "FieldName": "DateField",
              "Name": "EventDate",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Event date",
                  "Position": "2"
                }
              }
            },
            {
              "FieldName": "DateTimeField",
              "Name": "StartsAt",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Starts at",
                  "Position": "3"
                }
              }
            },
            {
              "FieldName": "TimeField",
              "Name": "DoorsOpen",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Doors open",
                  "Position": "4"
                }
              }
            },
            {
              "FieldName": "BooleanField",
              "Name": "Featured",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Featured",
                  "Position": "5"
                }
              }
            },
            {
              "FieldName": "HtmlField",
              "Name": "Agenda",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Agenda",
                  "Position": "6"
                }
              }
            },
            {
              "FieldName": "MultiTextField",
              "Name": "Speakers",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Speakers",
                  "Position": "7"
                }
              }
            },
            {
              "FieldName": "LinkField",
              "Name": "Website",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Website",
                  "Position": "8"
                }
              }
            },
            {
              "FieldName": "YoutubeField",
              "Name": "Teaser",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Teaser video",
                  "Position": "9"
                }
              }
            },
            {
              "FieldName": "MediaField",
              "Name": "Poster",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Poster",
                  "Position": "10"
                },
                "MediaFieldSettings": {
                  "Multiple": false
                }
              }
            },
            {
              "FieldName": "ContentPickerField",
              "Name": "RelatedEvents",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Related events",
                  "Position": "11"
                },
                "ContentPickerFieldSettings": {
                  "DisplayedContentTypes": [
                    "Showcase"
                  ],
                  "Multiple": true
                }
              }
            },
            {
              "FieldName": "UserPickerField",
              "Name": "Organizer",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Organizer",
                  "Position": "12"
                },
                "UserPickerFieldSettings": {
                  "Multiple": false
                }
              }
            }
          ]
        }
      ]
    }
  ]
}