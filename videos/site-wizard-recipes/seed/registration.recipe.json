{
  "name": "registration",
  "displayName": "Registration demo",
  "description": "Adds the Workshop Registration content type and its two step types for the demo site.",
  "author": "CrestApps",
  "version": "1.0",
  "steps": [
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "VisitorDetails",
          "DisplayName": "Visitor Details",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": false,
              "Listable": true,
              "Draftable": true,
              "Versionable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "VisitorDetails",
              "Name": "VisitorDetails",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            }
          ]
        },
        {
          "Name": "VisitPreferences",
          "DisplayName": "Visit Preferences",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": false,
              "Listable": true,
              "Draftable": true,
              "Versionable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "VisitPreferences",
              "Name": "VisitPreferences",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            }
          ]
        },
        {
          "Name": "WorkshopRegistration",
          "DisplayName": "Workshop Registration",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Draftable": true,
              "Versionable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                },
                "TitlePartSettings": {
                  "Options": "EditableRequired"
                }
              }
            },
            {
              "PartName": "AutoroutePart",
              "Name": "AutoroutePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "1"
                },
                "AutoroutePartSettings": {
                  "AllowCustomPath": false,
                  "Pattern": "{{ ContentItem | display_text | slugify }}",
                  "ShowHomepageOption": false
                }
              }
            }
          ]
        }
      ],
      "ContentParts": [
        {
          "Name": "VisitorDetails",
          "Settings": {
            "ContentPartSettings": {
              "Attachable": false
            }
          },
          "ContentPartFieldDefinitionRecords": [
            {
              "FieldName": "TextField",
              "Name": "FullName",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Full name",
                  "Position": "0"
                },
                "TextFieldSettings": {
                  "Required": false
                }
              }
            },
            {
              "FieldName": "TextField",
              "Name": "Email",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Email",
                  "Position": "1"
                },
                "TextFieldSettings": {
                  "Required": false
                }
              }
            }
          ]
        },
        {
          "Name": "VisitPreferences",
          "Settings": {
            "ContentPartSettings": {
              "Attachable": false
            }
          },
          "ContentPartFieldDefinitionRecords": [
            {
              "FieldName": "TextField",
              "Name": "Workshop",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Workshop",
                  "Position": "0"
                },
                "TextFieldSettings": {
                  "Required": false
                }
              }
            },
            {
              "FieldName": "TextField",
              "Name": "Notes",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Notes",
                  "Position": "1"
                },
                "TextFieldSettings": {
                  "Required": false
                }
              }
            }
          ]
        }
      ]
    }
  ]
}