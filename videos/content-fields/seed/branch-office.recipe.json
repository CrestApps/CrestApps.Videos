{
  "name": "branch-office",
  "displayName": "Branch Office content type",
  "description": "Adds a Branch Office content type (a title and a URL) for the demo site.",
  "author": "CrestApps",
  "version": "1.0",
  "steps": [
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "BranchOffice",
          "DisplayName": "Branch Office",
          "Settings": {
            "ContentTypeSettings": { "Creatable": true, "Listable": true, "Draftable": true, "Versionable": true, "Securable": true },
            "FullTextAspectSettings": {}
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": { "Position": "0" },
                "TitlePartSettings": { "Options": "EditableRequired" }
              }
            },
            {
              "PartName": "AutoroutePart",
              "Name": "AutoroutePart",
              "Settings": {
                "ContentTypePartSettings": { "Position": "1" },
                "AutoroutePartSettings": { "AllowCustomPath": false, "Pattern": "{{ ContentItem | display_text | slugify }}", "ShowHomepageOption": false }
              }
            }
          ]
        }
      ],
      "ContentParts": []
    }
  ]
}
