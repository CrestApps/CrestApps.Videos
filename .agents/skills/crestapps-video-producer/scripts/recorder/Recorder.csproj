<Project Sdk="Microsoft.NET.Sdk">
  <!-- The shared recorder. Each video keeps only its Scenes*.cs in videos/<slug>/recorder; see SKILL.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- The Playwright driver files exceed MAX_PATH under deep folders on Windows: build into a short path. -->
    <BaseOutputPath>$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'cavideo', 'bin'))$([System.IO.Path]::DirectorySeparatorChar)</BaseOutputPath>
  </PropertyGroup>
  <!-- A video's clips live in its own folder: build with -p:VideoScenes=<repo>/videos/<slug>/recorder to compile them
       in place of the template Scenes.cs. -->
  <ItemGroup Condition="'$(VideoScenes)' != ''">
    <Compile Remove="Scenes.cs" />
    <Compile Include="$(VideoScenes)/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>
</Project>
